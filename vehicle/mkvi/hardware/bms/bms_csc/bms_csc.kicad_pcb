	(gr_text "The isoSPI signal traces must be as direct as possible while\nisolated from adjacent circuitry by ground metal or space. No\ntraces must cross the isoSPI signal lines, unless separated by a\nground plane on an inner layer."
		(at 93.4974 116.7638 0)
		(layer "Cmts.User")
		(uuid "f9f8d82f-1285-4a1d-89fc-16116c1afc5e")
		(effects
			(font
				(size 0.5 0.5)
				(thickness 0.1)
			)
		)
	)
	(gr_text "A V- ground plane must not extend under the transformer,\nthe isoSPI connector, or in between the transformer and the\nconnector."
