http_archive(
    name = "log",
    build_file = "@//third_party/log:BUILD",
    strip_prefix = "log.c-master",
    url = "https://github.com/rxi/log.c/archive/refs/heads/master.zip",
)

http_archive(
    name = "cmocka",
    build_file = "@//third_party/cmocka:BUILD",
