# -- repo definitions -- #

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "cantools_deps",
    python_version ="3.9",
    requirements_lock = "//third_party/cantools:requirements.txt",   #@cantools_//:requirements.txt",
)

use_repo(pip, "cantools_deps")

pip.parse(
    hub_name = "pytest_deps",
    python_version ="3.9",
    requirements_lock = "//tools/pytest:requirements.txt",
)

use_repo(pip, "pytest_deps")

pip.parse(
    hub_name = "pydeps",
    python_version ="3.9",
    requirements_lock = "//third_party:requirements.txt",
)

use_repo(pip, "pydeps")

pip.parse(
    hub_name = "symbol_library_converter_deps",
    python_version ="3.9",
    requirements_lock = "//tools/symbols:requirements.txt",
)

use_repo(pip,"symbol_library_converter_deps")

pip.parse(
    hub_name = "bom_join_deps",
    python_version ="3.9",
    requirements_lock = "//tools/symbols:requirements.txt",
)
use_repo(pip, "bom_join_deps")

pip.parse(
    hub_name = "kibot_deps",
    python_version = "3.9",
    requirements_lock = "//scripts/kibot:requirements.txt",
)
use_repo(pip, "kibot_deps")

